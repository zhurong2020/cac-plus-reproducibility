# Documentation, not an applicable patch for this package.
#
# Target path `external/cac_plus_reference/ai_cac_inference_lib.py` belongs to the CAC Plus
# deployment toolkit, which is maintained separately and is not distributed here (see the
# Code availability statement). `git apply` will fail against this repository; the diff is
# shipped so that Online Methods M9's claim about the MONAI 1.5 migration can be read rather
# than taken on trust.
#
# What it does: MONAI 1.5 removed `SwinUNETR(img_size=...)`. The code branches on the
# installed MONAI version and OMITS the argument on 1.5+, while still passing it on 1.4.
# It does not restore or reintroduce the argument.
--- a/external/cac_plus_reference/ai_cac_inference_lib.py
+++ b/external/cac_plus_reference/ai_cac_inference_lib.py
@@ -132,12 +132,32 @@

     RESAMPLE_IMAGE_SIZE = (512, 512)

-    model = SwinUNETR(
-        spatial_dims=2,
-        img_size=RESAMPLE_IMAGE_SIZE,
-        in_channels=1,
-        out_channels=1,
-        feature_size=96,
-        use_checkpoint=True,
-        drop_rate=0.2,
-    ).to(device)
+    # MONAI compatibility: Handle both 1.4.0 and 1.5.1+ API changes
+    # - MONAI 1.4.0: requires img_size parameter
+    # - MONAI 1.5.1+: img_size removed, uses patch_size + window_size
+    import monai
+    monai_version = tuple(map(int, monai.__version__.split('.')[:2]))  # (1, 4) or (1, 5)
+
+    if monai_version >= (1, 5):
+        # MONAI 1.5.1+: img_size parameter removed
+        # Use default patch_size=2 and window_size=7
+        model = SwinUNETR(
+            spatial_dims=2,
+            in_channels=1,
+            out_channels=1,
+            feature_size=96,
+            use_checkpoint=True,
+            drop_rate=0.2,
+        ).to(device)
+    else:
+        # MONAI 1.4.0: requires img_size parameter
+        model = SwinUNETR(
+            spatial_dims=2,
+            img_size=RESAMPLE_IMAGE_SIZE,
+            in_channels=1,
+            out_channels=1,
+            feature_size=96,
+            use_checkpoint=True,
+            drop_rate=0.2,
+        ).to(device)

     if checkpoint_path:
