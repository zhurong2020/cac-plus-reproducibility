#!/usr/bin/env bash
# phi-hook-core: cardiac-shared/tools/phi_hook/pre-commit
#
# CANONICAL CORE. Do not edit this file inside a consuming repo: it must stay
# byte-identical to cardiac-shared/tools/phi_hook/pre-commit, and
# `tools/phi_hook/check_hooks.py` reports any difference as drift.
# Per-repo differences (allowlist, project-specific patterns, extra checks)
# go in .githooks/phi_hook.repo.sh, which this hook sources. See
# cardiac-shared/tools/phi_hook/README.md.
#
# Blocks PHI / PII / credential / cardiac-specific patterns from being
# committed. Even on a private repo, PHI in git history is a permanent
# liability: rewrites are expensive and incomplete (mirrors, forks and GitHub
# caches retain old refs). This hook is the cheap layer of defence.
#
# Setup (one-time per clone):
#     git config core.hooksPath .githooks
#
# Bypass once for a legitimate reference (e.g. documenting the cleanup itself):
#     CARDIAC_ALLOW_PII=1 git commit ...

set -eu

if [[ "${CARDIAC_ALLOW_PII:-0}" == "1" ]]; then
    exit 0
fi

# ---------------------------------------------------------------------------
# Core pattern groups (identical in every repo):
#   1. DICOM patient-folder layout: dicom_ + 7-8 digits, followed by a non-digit
#      or end of line. `\b` was used until 2026-10-19 and missed
#      dicom_<id>_Thorax, because `_` is a word character.
#   2. Patient-ID column names from the clinical databases, assigned a value
#   4. Chinese national ID: the label followed by digits, or a bare 18-digit
#      shape. Repos that also block the bare label add it in their extension.
#   5. Bare credential shapes (AWS AKIA, Stripe sk_live_, password=...)
#   6. Username-leaking absolute paths: /home/<user>/ or /Users/<user>/
#   9. Patient-name column headers (2026-09-11): patient_name_chinese / _pinyin,
#      or the Chinese header terms next to a half-width comma, tab or pipe as
#      in a CSV header row (prose uses the ideographic comma and is not hit).
# Not in the core, because the core is also synced into a PUBLIC repo:
#   3. Researcher names. They live in each private repo's extension file
#      (REPO_PATTERN) or in the gitignored local pattern file (group 8).
#   7. Project-specific patterns: REPO_PATTERN in the extension file.
# ---------------------------------------------------------------------------
PATTERN='dicom_[0-9]{7,8}([^0-9]|$)|patientingroupid\s*[:=]\s*["\x27]?[0-9]+|patient_in_group_id\s*[:=]\s*["\x27]?[0-9]+|身份证[^0-9\n]{0,10}[0-9]{6,}|\b[0-9]{17}[0-9Xx]\b|AKIA[0-9A-Z]{16}|sk_live_[A-Za-z0-9]{24,}|password\s*=\s*["\x27][^"\x27]{8,}|/home/[a-z][a-z0-9_-]*/|/Users/[a-z][a-z0-9_-]*/|patient_name_chinese|patient_name_pinyin|[,\t|]\s*(患者姓名|病人姓名)\s*[,\t|]'

# Allowlist: files that legitimately discuss the patterns themselves. Matched
# against the whole staged path (grep -x). .gitignore names sensitive paths and
# explains why each is excluded; that is the control working, not a leak.
ALLOWLIST_RE='\.githooks/pre-commit|\.githooks/phi_hook\.repo\.sh|\.githooks/README\.md|SECURITY\.md|CHANGELOG\.md|CLAUDE\.md|docs/THREAT_MODEL\.md|docs/legacy/README\.md|POST_BASELINE_TODO\.md|pyproject\.toml|LICENSE|\.gitignore'

# ---------------------------------------------------------------------------
# Per-repo extension point: .githooks/phi_hook.repo.sh (tracked, required).
# It is sourced here and may set:
#   REPO_PATTERN       ERE alternatives OR-ed into PATTERN (groups 3 and 7)
#   REPO_ALLOWLIST_RE  ERE alternatives OR-ed into ALLOWLIST_RE
#   repo_extra_checks  a function called with the staged, non-allowlisted
#                      paths; a non-zero return blocks the commit (it prints
#                      its own message)
# A missing extension file blocks the commit: dropping it silently would drop
# the repo's own patterns. A repo with no additions keeps an empty file.
# ---------------------------------------------------------------------------
TOPLEVEL="$(git rev-parse --show-toplevel)"
REPO_EXTENSION_FILE="$TOPLEVEL/.githooks/phi_hook.repo.sh"
REPO_PATTERN=''
REPO_ALLOWLIST_RE=''
if [[ ! -r "$REPO_EXTENSION_FILE" ]]; then
    echo "ERROR: pre-commit: .githooks/phi_hook.repo.sh is missing." >&2
    echo "       The PHI hook core needs this repo's extension file (it may be empty)." >&2
    echo "       See cardiac-shared/tools/phi_hook/README.md." >&2
    exit 1
fi
# shellcheck source=/dev/null
source "$REPO_EXTENSION_FILE"
[[ -n "$REPO_PATTERN" ]] && PATTERN="$PATTERN|$REPO_PATTERN"
[[ -n "$REPO_ALLOWLIST_RE" ]] && ALLOWLIST_RE="$ALLOWLIST_RE|$REPO_ALLOWLIST_RE"

# ---------------------------------------------------------------------------
# Group 8 — LOCAL patterns (2026-09-11). Patient names and other identifiers
# that must NOT be written into a tracked file, because putting them here
# would itself commit the very string we are trying to keep out.
# One regex per line in .githooks/phi_patterns.local (gitignored, per-clone).
# Blank lines and # comments are ignored.
# ---------------------------------------------------------------------------
LOCAL_PATTERN_FILE="$TOPLEVEL/.githooks/phi_patterns.local"
if [[ -r "$LOCAL_PATTERN_FILE" ]]; then
    LOCAL_PATTERN=$(grep -vE '^\s*(#|$)' "$LOCAL_PATTERN_FILE" | paste -sd'|' -)
    [[ -n "$LOCAL_PATTERN" ]] && PATTERN="$PATTERN|$LOCAL_PATTERN"
fi

# Hard stop: the local pattern file must never be committed, allowlisted or not.
if git diff --cached --name-only --diff-filter=AM | grep -qx '\.githooks/phi_patterns\.local'; then
    echo "ERROR: .githooks/phi_patterns.local is staged. It holds the very identifiers" >&2
    echo "       this hook exists to keep out of git. Unstage it and add it to .gitignore." >&2
    exit 1
fi

mapfile -t staged < <(
    git diff --cached --name-only --diff-filter=AM \
        | grep -vxE "$ALLOWLIST_RE" \
        || true
)

if (( ${#staged[@]} == 0 )); then
    exit 0
fi

if declare -F repo_extra_checks >/dev/null; then
    if ! repo_extra_checks "${staged[@]}"; then
        exit 1
    fi
fi

hits=$(git grep --cached -nE "$PATTERN" -- "${staged[@]}" 2>/dev/null || true)

if [[ -n "$hits" ]]; then
    cat >&2 <<HOOKMSG
============================================================
ERROR: pre-commit blocked — PHI / PII / credential pattern detected
============================================================

$hits

Pattern groups blocked:
  1. DICOM patient folders: dicom_NNNNNNN(N)
  2. Clinical-DB patient ID columns assigned a value
  3. Real names (this repo's .githooks/phi_hook.repo.sh or local file)
  4. Chinese national ID: label followed by digits, or 18-digit shape
  5. Hardcoded credentials (AWS, Stripe, password=...)
  6. Username-leaking paths: /home/<user>/ or /Users/<user>/
  7. Project-specific patterns from .githooks/phi_hook.repo.sh
  8. Local patterns from .githooks/phi_patterns.local, if present
  9. Patient-name column headers

If the match is legitimate (e.g. you are documenting the cleanup):
  1. add the file path to REPO_ALLOWLIST_RE in .githooks/phi_hook.repo.sh, or
  2. bypass once with: CARDIAC_ALLOW_PII=1 git commit ...

============================================================
HOOKMSG
    exit 1
fi

exit 0
